# Copy to .env and fill in. See the README for where to get each key.
FOX_MODEL_CHAIN=azure,gemini,groq,openai,anthropic,ollama
# Models for messages with images. Empty: models marked "can read images", then the chain above.
FOX_VISION_CHAIN=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

FOX_TTS_CHAIN=pyttsx3
FOX_TTS_ROBOT_EFFECT=true
FOX_TTS_RATE=170
FOX_EDGE_VOICE=en-US-GuyNeural
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

FOX_STT_CHAIN=faster_whisper
FOX_WHISPER_MODEL=base.en
FOX_WAKE_WORD=fox
